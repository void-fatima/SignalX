DATABASE_URL=postgresql+psycopg://signalx:signalx@localhost:5432/signalx
PROVIDER_MODE=mock
# Local runs stay in Mock mode. In Hosting, set PROVIDER_MODE=real explicitly.
# The current real-provider target is AvalAI, using the OpenAI-compatible Responses API.
# Keep this key empty locally; set the AvalAI key as OPENAI_API_KEY on API and Worker only.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_BASE_URL=https://api.avalai.ir/v1
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_OUTPUT_TOKENS=2000
# Optional endpoint-specific USD rates; provide all three or leave all blank.
# For AvalAI, use verified AvalAI rates; do not assume direct OpenAI pricing.
OPENAI_PRICE_VERSION=
OPENAI_INPUT_USD_PER_MILLION=
OPENAI_OUTPUT_USD_PER_MILLION=
CORS_ORIGINS=http://localhost:3000
AUTH_COOKIE_NAME=singnalx_session
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
SESSION_LIFETIME_SECONDS=604800
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
WORKER_POLL_SECONDS=1
HEARTBEAT_TIMEOUT_SECONDS=120
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_PATH=/integrations/telegram/webhook
