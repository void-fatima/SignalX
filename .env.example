DATABASE_URL=postgresql+psycopg://signalx:signalx@localhost:5432/signalx
PROVIDER_MODE=mock
# Agent factory only; enabling real mode in the HTTP API is a separate task.
# OPENAI_MODEL must support Responses API strict structured outputs.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_OUTPUT_TOKENS=2000
# Optional caller-supplied USD rates; provide all three or leave all blank.
OPENAI_PRICE_VERSION=
OPENAI_INPUT_USD_PER_MILLION=
OPENAI_OUTPUT_USD_PER_MILLION=
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
WORKER_POLL_SECONDS=1
HEARTBEAT_TIMEOUT_SECONDS=120
