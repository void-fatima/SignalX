DATABASE_URL=postgresql+psycopg://signalx:signalx@localhost:5432/signalx
PROVIDER_MODE=mock
# Local runs stay in Mock mode. In Hosting, set PROVIDER_MODE=real explicitly.
# LLM_PROVIDER selects the real provider; this template targets Gemini.
# OPENAI_MODEL must support Responses API strict structured outputs.
OPENAI_API_KEY=
OPENAI_MODEL=
# Default trusted endpoint; also accepted: https://api.avalai.ir/v1
# AvalAI uses the same OPENAI_API_KEY variable; verified smoke model: gpt-5.6-luna.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_OUTPUT_TOKENS=2000
# Optional endpoint-specific USD rates; provide all three or leave all blank.
# For AvalAI, use verified AvalAI rates; do not assume direct OpenAI pricing.
OPENAI_PRICE_VERSION=
OPENAI_INPUT_USD_PER_MILLION=
OPENAI_OUTPUT_USD_PER_MILLION=
# Do not put a real key in this file. Store GEMINI_API_KEY as a host secret.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_TIMEOUT_SECONDS=30
GEMINI_MAX_OUTPUT_TOKENS=2000
CORS_ORIGINS=http://localhost:3000
AUTH_COOKIE_NAME=singnalx_session
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
SESSION_LIFETIME_SECONDS=604800
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
WORKER_POLL_SECONDS=1
HEARTBEAT_TIMEOUT_SECONDS=120
