{
  "name": "singnalx-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "test:integration": "playwright test --config playwright.integration.config.ts",
    "generate:api": "openapi-typescript ../contracts/openapi.json -o lib/generated/api.d.ts",
    "generate:handoff": "openapi-typescript contracts/failure-handling.openapi.json -o lib/generated/failure-api.d.ts"
  },
  "dependencies": {
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "openapi-typescript": "^7.0.0",
    "tailwindcss": "4.3.3",
    "typescript": "~5.9.3"
  }
}
